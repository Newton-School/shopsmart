# MySQL — create DB: CREATE DATABASE shopmart CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# Encode special chars in password (@ → %40)
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/shopmart"
PORT=5001

# JWT signing secret (use a long random string in production)
JWT_SECRET="change-me-in-production-use-openssl-rand-hex-32"
JWT_EXPIRES_IN="7d"
